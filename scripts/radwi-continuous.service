[Unit]
Description=RADWI Cable-Quality Analyzer - Continuous Verdict Loop
After=network.target

[Service]
Type=forking
User=pi
Group=pi
WorkingDirectory=/home/pi/project-ali
Environment=TMPDIR=/tmp
ExecStartPre=-/usr/bin/tmux kill-session -t radwi
ExecStart=/usr/bin/tmux new-session -d -s radwi /home/pi/project-ali/.venv/bin/python3 -m src.main --voltage --continuous
ExecStop=/usr/bin/tmux kill-session -t radwi
Restart=on-failure
RestartSec=5
TimeoutStartSec=30
StartLimitIntervalSec=60
StartLimitBurst=5

[Install]
WantedBy=multi-user.target
