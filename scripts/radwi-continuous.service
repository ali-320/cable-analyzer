[Unit]
Description=RADWI Cable-Quality Analyzer - Continuous Verdict Loop
After=network.target

[Service]
Type=simple
WorkingDirectory=/home/pi/project-ali
ExecStart=/home/pi/project-ali/.venv/bin/python3 -m src.main --voltage --continuous
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal
TimeoutStartSec=30
StartLimitIntervalSec=60
StartLimitBurst=5

[Install]
WantedBy=multi-user.target
